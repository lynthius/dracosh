  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lynthius/dracosh.git"
  },
  "homepage": "https://github.com/lynthius/dracosh#readme",
  "bugs": {
    "url": "https://github.com/lynthius/dracosh/issues"
  },
  "keywords": [
    "cli",
    "tui",
    "vocabulary",
    "flashcards",
    "spaced-repetition",
    "anki",
    "ink",
    "pixel-art",
    "language-learning"
  ],
  "type": "module",
  "bin": {
